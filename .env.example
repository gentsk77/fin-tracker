# =============================================================================
# Supabase: Dashboard > Settings > API Keys
# Use the new publishable / secret keys (not the legacy anon / service_role keys)
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here
SUPABASE_SECRET_KEY=sb_secret_your-key-here

# =============================================================================
# Plaid (https://dashboard.plaid.com/developers/keys)
# =============================================================================
PLAID_CLIENT_ID=your-plaid-client-id
PLAID_SECRET=your-plaid-secret
# sandbox | development | production
PLAID_ENV=sandbox

# Encryption key for Plaid access tokens (AES-256-GCM, 32-byte base64).
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PLAID_TOKEN_ENCRYPTION_KEY=your-32-byte-base64-key

# =============================================================================
# App
# =============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
